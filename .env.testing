APP_NAME=OrderTracker
APP_ENV=testing
APP_KEY=base64:x62LR/eGO6TgZWNJx7tK0nROh4m6xiSmOrp0TNHA1tE=
APP_DEBUG=true
APP_URL=http://localhost

# In-memory SQLite for fast, isolated tests (overrides .env's MySQL).
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=

# Tests issue stateless token API requests, NOT stateful SPA requests.
# Emptying this prevents the custom EnsureFrontendRequestsAreStateful
# middleware from forcing CSRF (419) on every /api/* POST/PUT/DELETE.
# TENANT_BASE_DOMAIN is intentionally KEPT — tenant-resolver tests need it.
SANCTUM_STATEFUL_DOMAINS=

TENANT_BASE_DOMAIN=piyuralabs.com
TENANT_MARKETING_SUBDOMAIN=sos
TENANT_ADMIN_SUBDOMAIN=admin
TENANT_RESERVED_SUBDOMAINS=www,admin,api,app,sos,sos-admin

TURNSTILE_ENABLED=false

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
