APP_NAME=Laravel
# User-facing product name (Settings, invoices, browser title)
BRAND_APP="Simple Order Systems"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8084
# Production: APP_URL=https://your-domain.com — see docs/PRODUCTION.md

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=
# Local: leave empty for host-only cookies.
# Production: SESSION_DOMAIN=your-domain.com

# Single-tenant seed (created by `php artisan migrate --seed`)
SEED_TENANT_SLUG=default
SEED_TENANT_NAME="My Shop"
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL=owner@localhost
SEED_OWNER_PASSWORD=password
# Production: SANCTUM_STATEFUL_DOMAINS=your-domain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Sheets (OAuth per tenant). Sync inactive until owner connects Google + sets spreadsheet ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/integrations/google/callback"
SHEETS_RETRY_ATTEMPTS=3
SHEETS_BATCH_SIZE=50
# Telegram alerts on permanent Sheets sync failure (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_DISK=backups
# Required shared secret for the n8n POST /api/ops/backup webhook (X-N8N-Backup-Secret header). Empty = endpoint fails closed with 403.
N8N_BACKUP_SECRET=
MAINTENANCE_ALLOWED_IPS=
TRUSTED_PROXIES=

# Mayar dynamic QRIS (per-tenant API key stored encrypted in tenant_settings).
# Sandbox: MAYAR_BASE_URL=https://api.mayar.io — Prod: https://api.mayar.id
MAYAR_BASE_URL=https://api.mayar.id
# CSV of Mayar webhook egress IPs; empty = abort(403) — fail-closed.
# Find the IPs during sandbox testing before enabling in production.
MAYAR_WEBHOOK_IP_ALLOWLIST=